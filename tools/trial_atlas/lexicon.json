{
  "lexicon_version": "0.2.1-draft",
  "status": "Second draft for review (2026-10-10), revised after two blind reviews of 0.1.0. Written from the taxonomy in proposals/2026-10-10-trial-endpoint-atlas.md plus one added class (exercise_capacity, not yet confirmed by the maintainer). Not yet checked against any real registry wording or against the frozen set. Every rule carries examples that test_lexicon.py runs; they are made-up English, not registry text.",
  "matching": {
    "match_fields": ["measure"],
    "fallback_fields": ["description"],
    "fallback_excluded_rules": ["SAFE-UNSPEC", "SAFE-AE", "SAFE-AE2"],
    "note": "Rules run on the outcome's measure first. Only when no class rule (or only a vague one) matches there are they run on its description; from the description only the earliest match is kept, it is marked from_description, and generic safety wording (fallback_excluded_rules) never decides a class from there. The time frame is used for bucketing only. Patterns are Python regular expressions, case-insensitive unless case_sensitive is true. Before matching, every run of whitespace in the registry text (line breaks included) is collapsed to one space, so a pattern's single space matches a double space or a line break, and a negative such as 'non serious' cannot be dodged by spacing; each span is mapped back and is always an exact piece of the original text. A pattern is refused at load if it holds an inline (?x) flag, an escaped space, or a quantified group whose content is itself quantified."
  },
  "domains": [
    {"id": "pulmonary", "label": "Pulmonary function", "classes": [
      {"id": "fev1", "label": "FEV1"},
      {"id": "spirometry_other", "label": "Other spirometry"},
      {"id": "lci", "label": "Lung clearance index"},
      {"id": "lung_function_unspecified", "label": "Lung function, not specified"}]},
    {"id": "cftr_function", "label": "CFTR function", "classes": [
      {"id": "sweat_chloride", "label": "Sweat chloride", "cf_specific": true},
      {"id": "npd", "label": "Nasal potential difference", "cf_specific": true},
      {"id": "icm", "label": "Intestinal current measurement", "cf_specific": true},
      {"id": "cftr_biomarker_other", "label": "Other CFTR biomarker", "cf_specific": true}]},
    {"id": "exacerbations", "label": "Exacerbations", "classes": [
      {"id": "exacerbations", "label": "Pulmonary exacerbations", "negative_control": true,
       "note": "Only with a CF or pulmonary context (pulmonary, respiratory, protocol-defined, CF exacerbation, or PEx). A bare 'exacerbations' and asthma, COPD or ABPA exacerbations are left unclassified. Watched by the non-CF negative control."}]},
    {"id": "nutrition_growth", "label": "Nutrition and growth", "classes": [
      {"id": "nutrition_growth", "label": "Nutrition and growth"}]},
    {"id": "gi_pancreatic", "label": "Gastrointestinal and pancreatic", "classes": [
      {"id": "gi_pancreatic", "label": "Gastrointestinal and pancreatic"}]},
    {"id": "glucose_cfrd", "label": "Glucose and CF-related diabetes", "classes": [
      {"id": "glucose_cfrd", "label": "Glucose and CF-related diabetes"}]},
    {"id": "liver", "label": "Liver", "classes": [
      {"id": "liver", "label": "Liver", "note": "Liver disease measures. Liver blood tests (liver function tests, liver enzymes, ALT, AST, bilirubin) are safety (laboratory) only, unless liver-disease wording is also present."}]},
    {"id": "sinus_upper_airway", "label": "Sinus and upper airway", "classes": [
      {"id": "sinus_upper_airway", "label": "Sinus and upper airway"}]},
    {"id": "patient_reported", "label": "Patient-reported", "classes": [
      {"id": "cfqr", "label": "CFQ-R", "cf_specific": true},
      {"id": "pro_named_other", "label": "Other named instrument"},
      {"id": "pro_unnamed", "label": "Patient-reported, instrument not named"}]},
    {"id": "imaging", "label": "Imaging", "classes": [
      {"id": "imaging", "label": "Imaging", "note": "DXA and DEXA are not tagged imaging: they measure body composition (nutrition_growth, through its own words) or bone density (no class; left unclassified)."}]},
    {"id": "microbiology_sputum", "label": "Microbiology and sputum", "classes": [
      {"id": "microbiology_sputum", "label": "Microbiology and sputum"}]},
    {"id": "inflammation_markers", "label": "Inflammation markers", "classes": [
      {"id": "inflammation_markers", "label": "Inflammation markers"}]},
    {"id": "healthcare_use", "label": "Healthcare use", "classes": [
      {"id": "healthcare_use", "label": "Healthcare use"}]},
    {"id": "survival_transplant", "label": "Survival and transplant", "classes": [
      {"id": "survival_transplant", "label": "Survival and transplant"}]},
    {"id": "safety", "label": "Safety and tolerability", "classes": [
      {"id": "safety_tolerability", "label": "Safety and tolerability"}]},
    {"id": "pharmacokinetics", "label": "Pharmacokinetics", "classes": [
      {"id": "pharmacokinetics", "label": "Pharmacokinetics"}]},
    {"id": "feasibility_adherence", "label": "Feasibility and adherence", "classes": [
      {"id": "feasibility_adherence", "label": "Feasibility and adherence"}]},
    {"id": "exercise_capacity", "label": "Exercise capacity", "classes": [
      {"id": "exercise_capacity", "label": "Exercise capacity",
       "added": "Added 2026-10-10 after review; not in the design's taxonomy. The maintainer must confirm it before the frozen set is labelled."}]},
    {"id": "other", "label": "Other", "classes": [
      {"id": "other", "label": "Other", "assigned_by": "a model tag with an exact quote, or a person; no rule assigns it"}]},
    {"id": "not_stated", "label": "Not stated", "classes": [
      {"id": "not_stated", "label": "Not stated", "assigned_by": "rules NS-00, NS-01 and NS-V1 only"}]}
  ],
  "safety_subtypes": ["adverse_events", "serious_adverse_events", "laboratory", "vital_signs_ecg", "dose_limiting", "tolerability", "unspecified"],
  "rules": [
    {"id": "FEV1-01", "class": "fev1", "pattern": "(?<![A-Za-z0-9])(?:pp|p|%\\s*)?FEV\\s*[-_]?(?:1|₁)(?![0-9])",
     "note": "Only the explicit acronym. Vague wording is never read as FEV1 (see LUNGFN-V1, SPIRO-03).",
     "examples": {"match": ["Change in ppFEV1", "Change in pFEV1", "Absolute change in FEV1", "FEV 1 percent predicted", "FEV₁ (L)", "% FEV1"],
                  "no_match": ["Change in FEV6", "Lung function", "FEF25-75", "FVC"]}},
    {"id": "FEV1-02", "class": "fev1", "pattern": "\\bforced expiratory volume (?:in|at|during) (?:1|one|the first) ?s(?:ec(?:ond)?s?)?\\b",
     "examples": {"match": ["forced expiratory volume in one second", "Forced Expiratory Volume in 1 Second", "forced expiratory volume in 1 s",
                            "forced expiratory volume in 1s", "forced expiratory volume in 1 seconds", "forced expiratory volume in the first second"],
                  "no_match": ["forced expiratory volume in 6 seconds", "forced vital capacity"]}},
    {"id": "SPIRO-01", "class": "spirometry_other", "pattern": "\\bFVC\\b|\\bforced vital capacity\\b|\\bFEF\\s?25\\s?[-–]\\s?75|\\bFEF25|\\bpeak expiratory flow\\b|\\bforced expiratory flow\\b",
     "examples": {"match": ["Change in FVC", "forced vital capacity (L)", "FEF25-75", "Peak expiratory flow"],
                  "no_match": ["FEV1", "vital signs"]}},
    {"id": "SPIRO-02", "class": "spirometry_other", "pattern": "\\bspirometr(?:y|ic)\\b", "suppressed_by": ["fev1", "SPIRO-01"],
     "note": "The word spirometry alone; dropped when a named spirometric measure is matched, since it then names only the method.",
     "examples": {"match": ["Spirometry", "spirometric indices"], "no_match": ["spirometer calibration"]}},
    {"id": "SPIRO-03", "class": "spirometry_other",
     "pattern": "\\bforced expiratory volume\\b(?!\\s+(?:in|at|during)\\s+(?:1|one|the\\s+first)\\b)|\\bFEV\\b(?!\\s*[-_]?(?:1|₁|\\d))",
     "suppressed_by": ["fev1"],
     "note": "Forced expiratory volume with no one-second timing written: an explicit spirometric measure, never read as FEV1.",
     "examples": {"match": ["FEV (forced expiratory volume)", "Forced expiratory volume (L)"], "no_match": ["FEV1", "FEV 1", "FEV6"]}},
    {"id": "LCI-01", "class": "lci", "pattern": "\\blung clearance index\\b|\\bmultiple[- ]breath (?:inert gas |nitrogen |sulph?ur hexafluoride )?washout\\b",
     "examples": {"match": ["Change in lung clearance index", "Multiple-breath washout"], "no_match": ["mucociliary clearance", "airway clearance"]}},
    {"id": "LCI-02", "class": "lci", "pattern": "\\bLCI(?:\\s?2\\.5|5)?\\b|\\bMBW\\b", "case_sensitive": true,
     "examples": {"match": ["LCI2.5", "Change in LCI", "MBW outcomes"], "no_match": ["lci", "PLCI score"]}},
    {"id": "LUNGFN-V1", "class": "lung_function_unspecified", "vague": true, "pattern": "\\b(?:lung|pulmonary|respiratory) function(?: tests?| testing)?\\b",
     "suppressed_by": ["fev1", "spirometry_other", "lci"],
     "note": "Vague wording. Never inferred to FEV1; its share is reported as a finding.",
     "examples": {"match": ["Lung function", "Improvement in pulmonary function", "respiratory function tests"], "no_match": ["liver function", "lung transplant"]}},
    {"id": "SWEAT-01", "class": "sweat_chloride", "pattern": "\\bsweat[\\s-]+(?:chloride|cl-?)(?![a-z])|\\bsweat test(?:ing)?\\b|\\bswcl\\b",
     "examples": {"match": ["Change in sweat chloride", "Sweat Cl concentration", "sweat test", "SwCl"], "no_match": ["night sweats", "chloride channel"]}},
    {"id": "NPD-01", "class": "npd", "pattern": "\\bnasal potential difference\\b",
     "examples": {"match": ["Change in nasal potential difference"], "no_match": ["nasal polyps"]}},
    {"id": "NPD-02", "class": "npd", "pattern": "\\bNPD\\b", "case_sensitive": true,
     "examples": {"match": ["NPD response"], "no_match": ["npd"]}},
    {"id": "ICM-01", "class": "icm", "pattern": "\\bintestinal current measurements?\\b|\\bshort[- ]circuit current\\b|\\bUssing chambers?\\b",
     "examples": {"match": ["Intestinal current measurement", "short-circuit current in rectal biopsies"], "no_match": ["intestinal obstruction"]}},
    {"id": "ICM-02", "class": "icm", "pattern": "\\bICM\\b", "case_sensitive": true,
     "examples": {"match": ["ICM in rectal biopsies"], "no_match": ["icm"]}},
    {"id": "CFTRBIO-01", "class": "cftr_biomarker_other",
     "pattern": "\\bCFTR[\\s-]+(?:gene[\\s-]+)?(?:function|activity|protein|expression|mRNA|maturation|conductance)\\b|\\borganoids?\\b|\\bforskolin[- ]induced swelling\\b",
     "suppressed_by": ["sweat_chloride", "npd", "icm"],
     "note": "Dropped when the entry names sweat chloride, NPD or ICM: the named measure is then the class.",
     "examples": {"match": ["CFTR function in nasal cells", "Forskolin-induced swelling of organoids", "CFTR gene expression"], "no_match": ["CFTR modulator", "CFTR genotype"]}},
    {"id": "EXAC-01", "class": "exacerbations",
     "pattern": "\\b(?:pulmonary|respiratory|protocol[- ]defined|CF|cystic fibrosis)[- ](?:[\\w-]+[- ])?exacerbations?\\b|\\bexacerbations? of (?:CF|cystic fibrosis|pulmonary|lung|respiratory)\\b",
     "note": "Requires a CF or pulmonary context; asthma, COPD and ABPA exacerbations and a bare 'exacerbations' are not tagged.",
     "examples": {"match": ["Rate of pulmonary exacerbations", "Time to first protocol-defined pulmonary exacerbation", "Number of CF exacerbations"],
                  "no_match": ["Rate of moderate or severe COPD exacerbations", "Asthma exacerbations", "ABPA exacerbations", "Exacerbations of asthma", "Exacerbating factors"]}},
    {"id": "EXAC-02", "class": "exacerbations", "pattern": "\\bPEx\\b", "case_sensitive": true,
     "examples": {"match": ["Number of PEx"], "no_match": ["pex"]}},
    {"id": "NUTR-01", "class": "nutrition_growth",
     "pattern": "\\bbody mass index\\b|(?<!by )\\bbody weight\\b(?![- ]based)|\\bweight (?:gain|loss|change|z[- ]?scores?|percentiles?|velocity|status)\\b|\\bchange in (?:body )?weight\\b(?![- ]based)|\\bweight[- ]for[- ](?:age|length|height)\\b|\\b(?:height|length|weight|BMI)[- ]z[- ]?scores?\\b|\\b(?:change in|linear|standing) height\\b|\\bheight (?:gain|velocity|z[- ]?scores?|percentiles?|for[- ]age|SDS)\\b|\\bnutritional status\\b|\\bfat[- ]free mass\\b|\\blean (?:body )?mass\\b|\\bbody composition\\b|\\banthropometr\\w*|\\bgrowth (?:velocity|rate)\\b|\\bmid[- ]upper arm circumference\\b|\\bvitamin [ADEK]\\b|\\bfat[- ]soluble vitamins?\\b",
     "note": "No bare 'weight' or 'height': dosing by weight and the height of an object are not growth.",
     "examples": {"match": ["Change in body mass index", "Weight-for-age z-score", "Weight gain", "Change in height", "fat-free mass", "Serum vitamin D"],
                  "no_match": ["bacterial growth", "heightened", "Dose by weight", "Weight-based dosing", "Molecular weight", "Height of the nebulizer stand", "Body weight-based dosing", "Dose by body weight"]}},
    {"id": "NUTR-02", "class": "nutrition_growth", "pattern": "\\bBMI\\b", "case_sensitive": true,
     "examples": {"match": ["Change in BMI"], "no_match": ["bmi"]}},
    {"id": "GI-01", "class": "gi_pancreatic",
     "pattern": "\\bcoefficient of fat absorption\\b|\\bfat absorption\\b|\\bfa?ecal elastase\\b|\\bfa?ecal fat\\b|\\bsteatorrho?ea\\b|\\bpancreatic (?:function|insufficiency|sufficiency|enzymes?|elastase)\\b|\\bstool (?:fat|frequency|consistency)\\b|\\bgastrointestinal symptoms?\\b|\\bdistal intestinal obstruction\\b|\\bconstipation\\b|\\babdominal pain\\b|\\bimmunoreactive trypsinogen\\b|\\bfa?ecal calprotectin\\b|\\bmalabsorption\\b",
     "examples": {"match": ["Coefficient of fat absorption", "Faecal elastase", "Fecal fat excretion", "Abdominal pain score", "distal intestinal obstruction syndrome"], "no_match": ["pancreatitis", "fat-free mass"]}},
    {"id": "GI-02", "class": "gi_pancreatic", "pattern": "\\bCFA\\b|\\bDIOS\\b|\\bIRT\\b", "case_sensitive": true,
     "examples": {"match": ["Change in CFA", "Episodes of DIOS"], "no_match": ["cfa"]}},
    {"id": "GLU-01", "class": "glucose_cfrd",
     "pattern": "\\bglucose\\b|\\bHbA1c\\b|\\bha?emoglobin A1c\\b|\\bglycated ha?emoglobin\\b|\\binsulin\\b|\\b(?:cystic fibrosis|CF)[- ]related diabetes\\b|\\bdiabetes\\b|\\bglyca?emic\\b",
     "examples": {"match": ["Change in HbA1c", "Oral glucose tolerance test", "Insulin secretion", "Glycaemic control"], "no_match": ["glucagon-like peptide receptor"]}},
    {"id": "GLU-02", "class": "glucose_cfrd", "pattern": "\\bOGTT\\b|\\bCFRD\\b|\\bA1C\\b", "case_sensitive": true,
     "examples": {"match": ["2-hour OGTT", "Incidence of CFRD"], "no_match": ["ogtt"]}},
    {"id": "LIVER-01", "class": "liver",
     "pattern": "\\bliver\\b(?! (?:function tests?|function panel|enzymes?|enzyme elevations?|tests?|panel|transaminases?|chemistry))|\\bhepatic (?:fibrosis|steatosis|stiffness|disease)\\b|\\bcirrhosis\\b|\\bhepatobiliary\\b|\\bbiliary\\b|\\bportal hypertension\\b",
     "note": "Liver blood tests are safety (laboratory) only; see the liver class note.",
     "examples": {"match": ["Change in liver stiffness", "Hepatic steatosis", "Portal hypertension", "Liver disease progression"],
                  "no_match": ["hepatic impairment cohort", "deliverable", "Liver function tests", "Liver enzymes"]}},
    {"id": "LIVER-02", "class": "liver", "pattern": "\\bCFLD\\b", "case_sensitive": true,
     "examples": {"match": ["Progression of CFLD"], "no_match": ["cfld"]}},
    {"id": "SINUS-01", "class": "sinus_upper_airway",
     "pattern": "\\bsinus(?:es)?\\b(?! (?:rhythm|tachycardia|bradycardia|arrhythmia))|\\bsinusitis\\b|\\brhinosinusitis\\b|\\bsino[- ]?nasal\\b|\\bnasal polyp\\w*|\\bupper airways?\\b|\\bparanasal\\b|\\bSNOT[- ]?2[02]\\b",
     "examples": {"match": ["Sinus symptoms", "Chronic rhinosinusitis", "Sino-Nasal Outcome Test", "nasal polyp score"], "no_match": ["sinus rhythm on ECG", "nasal potential difference"]}},
    {"id": "CFQR-01", "class": "cfqr", "pattern": "\\bCFQ[- ]?R\\b|\\bcystic fibrosis questionnaire(?:[- ]revised)?\\b|\\bCFQ\\b",
     "examples": {"match": ["CFQ-R respiratory domain", "Cystic Fibrosis Questionnaire-Revised", "CFQR"], "no_match": ["questionnaire"]}},
    {"id": "PRO-01", "class": "pro_named_other",
     "pattern": "\\bSF[- ]?(?:36|12)\\b|\\bEQ[- ]?5D(?:[- ][35]L|-Y)?\\b|\\bPedsQL\\b|\\bSGRQ\\b|\\bSt\\.? George'?s Respiratory Questionnaire\\b|\\bCRISS\\b|\\bCFRSD\\b|\\bCystic Fibrosis Respiratory Symptom Diary\\b|\\bQOL[- ]B\\b|\\bLeicester Cough Questionnaire\\b|\\bSNOT[- ]?2[02]\\b|\\bSino[- ]?Nasal Outcome Test\\b|\\bPROMIS\\b|\\bHADS\\b|\\bPHQ[- ]?9\\b|\\bGAD[- ]?7\\b|\\bTSQM\\b|\\bAsthma Control Questionnaire\\b",
     "note": "Named instruments other than the CFQ-R. Instrument names are kept as written; no acronym is expanded.",
     "examples": {"match": ["EQ-5D-5L", "SNOT-22 score", "St George's Respiratory Questionnaire", "CFRSD-CRISS"], "no_match": ["quality of life", "CFQ-R"]}},
    {"id": "PRO-02", "class": "pro_unnamed",
     "pattern": "\\bquality of life\\b|\\bQoL\\b|\\bpatient[- ]reported\\b|\\bquestionnaires?\\b|\\bsymptom (?:scores?|diary|diaries|burden)\\b|\\bsatisfaction\\b|\\bwell[- ]being\\b",
     "suppressed_by": ["cfqr", "pro_named_other"],
     "examples": {"match": ["Quality of life", "Patient-reported symptoms", "Treatment satisfaction"], "no_match": ["quality control"]}},
    {"id": "IMG-01", "class": "imaging",
     "pattern": "\\bcomputed tomography\\b|\\bmagnetic resonance\\b|\\bchest (?:x[- ]?ray|radiograph\\w*)\\b|\\bradiograph\\w*|\\bultrasound\\b|\\bultrasonograph\\w*|\\belastography\\b|\\bBrody score\\b|\\bimaging\\b|\\bscintigraph\\w*|\\bhyperpolari[sz]ed\\b",
     "examples": {"match": ["Chest computed tomography score", "Transient elastography", "Chest X-ray"], "no_match": ["image quality questionnaire"]}},
    {"id": "IMG-02", "class": "imaging", "pattern": "\\bCT\\b|\\bMRI\\b|\\bHRCT\\b", "case_sensitive": true,
     "note": "DXA and DEXA are deliberately absent; see the imaging class note.",
     "examples": {"match": ["Chest CT score", "Lung MRI"], "no_match": ["ct", "CTX", "Bone mineral density by DXA"]}},
    {"id": "MICRO-01", "class": "microbiology_sputum",
     "pattern": "\\bsputum (?:cultures?|microbiology|microbiome|bacterial (?:load|density))\\b|\\bpseudomonas\\b|\\bP\\.? ?aeruginosa\\b|\\bstaphylococc\\w*|\\bS\\.? ?aureus\\b|\\bburkholderia\\b|\\bmycobacteri\\w*|\\bbacterial (?:load|density|counts?)\\b|\\bcolony[- ]forming units?\\b|\\bmicrobio(?:me|ta|logy|logical)\\b|\\beradication\\b|\\b(?:throat|bacterial) cultures?\\b|\\bpositive (?:\\w+ )?cultures?\\b|\\bculture[- ]positive\\b|\\bculture conversion\\b|\\baspergillus\\b|\\bfungal\\b|\\bstenotrophomonas\\b|\\bachromobacter\\b",
     "examples": {"match": ["Sputum Pseudomonas aeruginosa density", "Eradication of P. aeruginosa", "Mycobacterial culture conversion", "Time to first positive culture"],
                  "no_match": ["cell culture", "Sputum volume"]}},
    {"id": "MICRO-02", "class": "microbiology_sputum", "pattern": "\\bMRSA\\b|\\bNTM\\b|\\bCFU\\b", "case_sensitive": true,
     "examples": {"match": ["MRSA eradication", "NTM culture"], "no_match": ["cfu"]}},
    {"id": "MICRO-03", "class": "microbiology_sputum",
     "pattern": "\\bsputum\\b(?! (?:volume|production|weight|wet weight|viscosity|colou?r|properties|expectoration|clearance|induction|symptoms?|scores?))",
     "suppressed_by": ["inflammation_markers", "pharmacokinetics"],
     "note": "The word sputum alone is weak: dropped when the entry measures inflammation or a drug level in sputum, and never for sputum volume, production or other symptom words.",
     "examples": {"match": ["Sputum samples"], "no_match": ["Sputum volume", "Daily sputum production"]}},
    {"id": "INFL-01", "class": "inflammation_markers",
     "pattern": "\\binflammat(?:ion|ory)\\b|\\bneutrophil elastase\\b|\\binterleukin[- ]?\\w*|\\bIL[- ]?(?:\\d{1,2}[A-Za-z]?|1β|1beta)\\b|\\bC-reactive protein\\b|\\btumou?r necrosis factor\\b|\\bcalprotectin\\b|\\bcytokines?\\b|\\bneutrophil (?:counts?|numbers?)\\b|\\bwhite (?:blood )?cell counts?\\b",
     "examples": {"match": ["Sputum neutrophil elastase", "IL-8 concentration", "IL-10 concentration", "IL-1beta", "Inflammatory markers", "C-reactive protein"], "no_match": ["neutrophil function assay"]}},
    {"id": "INFL-02", "class": "inflammation_markers", "pattern": "\\bCRP\\b|\\bTNF\\b", "case_sensitive": true,
     "examples": {"match": ["Serum CRP", "TNF level"], "no_match": ["crp"]}},
    {"id": "HCU-01", "class": "healthcare_use",
     "pattern": "\\bhospitali[sz](?:ations?|ed)\\b|\\bhospital (?:admissions?|days|stays?|visits?)\\b|\\blength of (?:hospital )?stay\\b|\\bemergency (?:department|room) visits?\\b|\\bdays? (?:on|of|receiving) (?:IV |intravenous |oral |inhaled )?antibiotics?\\b|\\b(?:IV |intravenous |oral |inhaled )?antibiotic (?:use|usage|courses?|days|treatment|prescriptions?)\\b|\\bhealth ?care (?:use|utili[sz]ation|resource use|costs?)\\b|\\bresource (?:use|utili[sz]ation)\\b|\\bcosts?\\b|\\bcost[- ]effectiveness\\b|\\bclinic visits?\\b",
     "examples": {"match": ["Number of hospitalizations", "Days of intravenous antibiotic treatment", "Days on IV antibiotics", "Antibiotic use", "Healthcare costs"], "no_match": ["hospital-based study"]}},
    {"id": "SURV-01", "class": "survival_transplant",
     "pattern": "\\bsurvival\\b|\\bmortality\\b|\\bbronchiolitis obliterans\\b|\\bchronic lung allograft dysfunction\\b|\\b(?:time to|need for|referral for|listing for|rate of|freedom from|incidence of|number of) (?:\\w+ )?transplant(?:ation|s)?\\b",
     "examples": {"match": ["Overall survival", "Time to lung transplantation", "All-cause mortality"], "no_match": ["survey", "FEV1 in lung transplant recipients"]}},
    {"id": "SURV-02", "class": "survival_transplant", "pattern": "\\bCLAD\\b|\\bBOS\\b", "case_sensitive": true,
     "examples": {"match": ["Freedom from CLAD"], "no_match": ["bos"]}},
    {"id": "SURV-03", "class": "survival_transplant", "pattern": "\\bdeaths?\\b|\\bdied\\b", "suppressed_by": ["safety_tolerability"],
     "note": "Deaths counted inside a safety outcome stay safety.",
     "examples": {"match": ["Number of deaths"], "no_match": ["deathly"]}},
    {"id": "SURV-04", "class": "survival_transplant", "pattern": "\\btransplant(?:ation|ed|s)?\\b|\\bgraft\\b", "suppressed_by_any_other_class": true,
     "note": "Transplant without an outcome word is weak: dropped whenever the entry names any other class (it then describes the population).",
     "examples": {"match": ["Lung transplant"], "no_match": ["transplanting seedlings"]}},
    {"id": "SAFE-AE", "class": "safety_tolerability", "subtype": "adverse_events",
     "pattern": "(?<!serious )\\badverse (?:events?|effects?|reactions?|drug reactions?)\\b|\\bside[- ]effects?\\b|\\btreatment[- ]emergent\\b",
     "examples": {"match": ["Number of participants with adverse events", "Side effects", "Treatment-emergent events"], "no_match": ["Number of participants with serious adverse events"]}},
    {"id": "SAFE-NONSAE", "class": "safety_tolerability", "subtype": "adverse_events",
     "pattern": "\\bnon[- ]?serious adverse (?:events?|effects?|reactions?)\\b|\\bnon[- ]?SAEs?\\b",
     "note": "Non-serious adverse events are adverse events, never serious ones.",
     "examples": {"match": ["Number of non-serious adverse events", "Nonserious adverse events", "Incidence of non-SAEs"], "no_match": ["serious adverse events"]}},
    {"id": "SAFE-AE2", "class": "safety_tolerability", "subtype": "adverse_events", "pattern": "\\bT?EAEs?\\b|\\bAEs?\\b", "case_sensitive": true,
     "examples": {"match": ["Incidence of TEAEs", "AEs by severity"], "no_match": ["aes", "SAEs"]}},
    {"id": "SAFE-SAE", "class": "safety_tolerability", "subtype": "serious_adverse_events",
     "pattern": "(?<!non-)(?<!non )(?<!non)\\bserious adverse (?:events?|reactions?)\\b",
     "examples": {"match": ["Number of participants with serious adverse events"], "no_match": ["adverse events", "non-serious adverse events", "non serious adverse events"]}},
    {"id": "SAFE-SAE2", "class": "safety_tolerability", "subtype": "serious_adverse_events", "pattern": "(?<!non-)(?<!non)\\bSAEs?\\b", "case_sensitive": true,
     "examples": {"match": ["Incidence of SAEs"], "no_match": ["saes", "non-SAEs"]}},
    {"id": "SAFE-LAB", "class": "safety_tolerability", "subtype": "laboratory",
     "pattern": "\\b(?:clinical |safety )?laboratory (?:values?|abnormalit\\w*|parameters?|tests?|assessments?|results?)\\b|\\blab abnormalit\\w*|\\bliver (?:function|enzymes?) (?:tests?|elevations?|abnormalit\\w*)\\b|\\bliver function panel\\b|\\bliver enzymes?\\b|\\btransaminases?\\b|\\baminotransferases?\\b|\\bbilirubin\\b|\\bha?ematology\\b|\\bclinical chemistry\\b|\\burinalysis\\b",
     "examples": {"match": ["Clinical laboratory abnormalities", "Liver enzyme elevations", "Liver function tests", "Total bilirubin", "Haematology"], "no_match": ["laboratory-confirmed infection"]}},
    {"id": "SAFE-LAB2", "class": "safety_tolerability", "subtype": "laboratory", "pattern": "\\bALT\\b|\\bAST\\b|\\bLFTs?\\b|\\bGGT\\b", "case_sensitive": true,
     "examples": {"match": ["Change in ALT", "AST elevations", "Abnormal LFTs"], "no_match": ["alt", "last"]}},
    {"id": "SAFE-VITAL", "class": "safety_tolerability", "subtype": "vital_signs_ecg",
     "pattern": "\\bvital signs?\\b|\\belectrocardiogra\\w*|\\bECGs?\\b|\\bQTc?F?\\b|\\bblood pressure\\b|\\bheart rate\\b",
     "examples": {"match": ["Vital signs", "12-lead ECG", "QTcF interval"], "no_match": ["vitality"]}},
    {"id": "SAFE-DLT", "class": "safety_tolerability", "subtype": "dose_limiting",
     "pattern": "\\bdose[- ]limiting toxicit\\w*|\\bmaximum tolerated dose\\b",
     "examples": {"match": ["Dose-limiting toxicities", "Maximum tolerated dose"], "no_match": ["dose finding"]}},
    {"id": "SAFE-DLT2", "class": "safety_tolerability", "subtype": "dose_limiting", "pattern": "\\bDLTs?\\b|\\bMTD\\b", "case_sensitive": true,
     "examples": {"match": ["Number of DLTs", "MTD"], "no_match": ["dlt"]}},
    {"id": "SAFE-TOL", "class": "safety_tolerability", "subtype": "tolerability",
     "pattern": "\\btolerability\\b|\\btolerated\\b|(?<!glucose )(?<!exercise )(?<!heat )(?<!cold )\\btolerance\\b(?! test)|\\bdiscontinu\\w* (?:due to|because of)\\b|\\bwithdraw\\w* (?:due to|because of)\\b|\\bbronchospasm\\b|\\bbronchoconstriction\\b",
     "examples": {"match": ["Tolerability", "Discontinuation due to adverse events", "Acute bronchospasm"],
                  "no_match": ["oral glucose tolerance test", "glucose tolerance", "Exercise tolerance", "Heat tolerance", "Cold tolerance"]}},
    {"id": "SAFE-UNSPEC", "class": "safety_tolerability", "subtype": "unspecified", "pattern": "\\bsafety\\b|\\btoxicit(?:y|ies)\\b",
     "suppressed_by": ["SAFE-AE", "SAFE-NONSAE", "SAFE-AE2", "SAFE-SAE", "SAFE-SAE2", "SAFE-LAB", "SAFE-LAB2", "SAFE-VITAL", "SAFE-DLT", "SAFE-DLT2", "SAFE-TOL"],
     "note": "The word safety alone; its subtype is unspecified unless another safety rule names what was measured.",
     "examples": {"match": ["Safety", "Toxicity"], "no_match": ["safely"]}},
    {"id": "PK-01", "class": "pharmacokinetics",
     "pattern": "\\bpharmacokinetic\\w*|\\b(?:plasma|serum|blood) (?!(?:vitamin|25|zinc|iron|ferritin|albumin|glucose|insulin|cholesterol|bilirubin|creatinine|sodium|chloride|calcium|magnesium|phosph|retinol|tocopherol|fatty|lipid|protein|IgE|IgG|cytokine|IL|interleukin|calprotectin|CRP)\\w*)(?:[\\w-]+ )?(?:concentrations?|levels?)\\b(?! of (?:vitamin|25|zinc|iron|ferritin|albumin|glucose|insulin|cholesterol|bilirubin|creatinine|sodium|chloride|calcium|magnesium|phosph|retinol|tocopherol|fatty|lipid|protein|IgE|IgG|cytokine|IL|interleukin|calprotectin|CRP))|\\bconcentrations? of (?!(?:vitamin|25|zinc|iron|ferritin|albumin|glucose|insulin|cholesterol|bilirubin|creatinine|sodium|chloride|calcium|magnesium|phosph|retinol|tocopherol|fatty|lipid|protein|IgE|IgG|cytokine|IL|interleukin|calprotectin|CRP)\\w*)[\\w-]+ in (?:plasma|serum|sputum|blood)\\b|\\b[\\w-]+ concentrations? in (?:plasma|serum|sputum|blood)\\b|\\bmaximum (?:plasma |serum |observed )?concentration\\b|\\barea under the (?:plasma |serum )?(?:concentration[- ]time )?curve\\b|\\bhalf[- ]life\\b|\\btrough (?:concentrations?|levels?)\\b|\\bbioavailability\\b|\\bbioequivalence\\b|\\b(?:apparent|renal|total body|oral|systemic) clearance\\b|\\bvolume of distribution\\b|\\btime to (?:maximum|peak) (?:plasma )?concentration\\b",
     "note": "A drug level in plasma, serum, blood or sputum. Nutrient and biomarker levels (vitamins, glucose, proteins, cytokines and the like) are excluded by name.",
     "examples": {"match": ["Maximum plasma concentration", "Area under the concentration-time curve", "Half-life", "Apparent clearance", "Plasma ivacaftor concentration",
                            "Serum tobramycin concentrations", "Concentration of tobramycin in plasma", "Trough levels", "Ivacaftor concentration in sputum"],
                  "no_match": ["lung clearance index", "airway clearance", "Serum concentration of vitamin D", "Plasma glucose concentration", "Plasma IL-6 levels"]}},
    {"id": "PK-02", "class": "pharmacokinetics", "pattern": "\\bPK\\b|\\bC\\s?max\\b|\\bAUC\\w*|\\bT\\s?max\\b|\\bt1/2|\\bt½|\\bCL/F\\b|\\bCtrough\\b", "case_sensitive": true,
     "examples": {"match": ["Cmax", "AUC0-24", "Half-life (t1/2)", "PK parameters"], "no_match": ["pk", "cmax"]}},
    {"id": "FEAS-01", "class": "feasibility_adherence",
     "pattern": "\\badherence\\b|\\bcompliance\\b|\\bfeasibility\\b|\\brecruitment (?:rates?|targets?)\\b|\\bretention\\b|\\bacceptability\\b|\\bcompletion rates?\\b|\\busability\\b|(?<!oxygen )(?<!O2 )\\buptake\\b|\\bproportion of (?:participants|patients|subjects) (?:who )?(?:completed?|completing)\\b",
     "examples": {"match": ["Adherence to airway clearance", "Feasibility of recruitment", "Retention at 12 months", "Uptake of the intervention"], "no_match": ["adherent mucus", "Peak oxygen uptake"]}},
    {"id": "EXER-01", "class": "exercise_capacity",
     "pattern": "\\b(?:six|6)[- ]?min(?:ute)?[- ]walk(?:ing)?(?: test| distance)?\\b|\\bpeak oxygen (?:uptake|consumption)\\b|\\bmaximal oxygen (?:uptake|consumption)\\b|\\bVO2 ?(?:peak|max)\\b|\\bpeak VO2\\b|\\bexercise (?:capacity|tolerance|performance|endurance)\\b|\\bcardiopulmonary exercise test(?:ing)?\\b|\\bshuttle walk(?:ing)? test\\b",
     "note": "A class added after review (see the exercise_capacity class).",
     "examples": {"match": ["Six-minute walk distance", "Peak oxygen uptake (VO2 peak)", "Exercise capacity", "Exercise tolerance"], "no_match": ["Exercise diary", "walking aid"]}},
    {"id": "EXER-02", "class": "exercise_capacity", "pattern": "\\b6MWT\\b|\\b6MWD\\b|\\bCPET\\b|\\bISWT\\b", "case_sensitive": true,
     "examples": {"match": ["Change in 6MWD", "CPET outcomes"], "no_match": ["6mwd"]}}
  ],
  "composite_rules": [
    {"id": "COMP-01", "pattern": "\\bcomposite (?:end ?points?|outcomes?|measures?)\\b|\\bcomposite of\\b|\\bcombined (?:end ?points?|outcomes?)\\b|\\btime to (?:the )?first of\\b",
     "note": "Sets the composite flag; the component classes are the class tags of the same entry. Matched on measure and description. The bare word 'composite' (a composite score) does not count.",
     "examples": {"match": ["Composite of exacerbation or hospitalization", "Composite endpoint of death or transplant", "Combined endpoint"],
                  "no_match": ["compositional analysis", "Composite score of symptoms", "Brody composite score"]}}
  ],
  "not_stated_rules": [
    {"id": "NS-00", "kind": "no_primary_outcome", "note": "The study entered no primary outcome. Applied in code, not by a pattern."},
    {"id": "NS-01", "kind": "placeholder", "pattern": "^\\s*(?:TBD|TBA|N/?A|none|not applicable|to be (?:determined|confirmed)|unknown|-+|\\.+)?\\s*$",
     "note": "Applied to the measure when no class rule matched in measure or description.",
     "examples": {"match": ["TBD", "", "N/A", "--"], "no_match": ["FEV1", "Efficacy"]}},
    {"id": "NS-V1", "kind": "vague", "pattern": "\\b(?:efficacy|effectiveness|clinical (?:benefit|response|outcome|improvement|efficacy)|treatment (?:response|effect|success)|therapeutic effect|response to treatment)\\b",
     "note": "Wording that names no measure. Applied when no class rule matched; the entry is 'not stated' with the vague flag, and never read as FEV1.",
     "examples": {"match": ["Efficacy", "Clinical benefit", "Treatment response"], "no_match": ["Adverse events"]}}
  ],
  "timeframe": {
    "units_in_days": {"minute": 0.0006944444444444445, "hour": 0.041666666666666664, "day": 1, "week": 7, "month": 30.4375, "year": 365.25},
    "unit_words": {"minutes": "minute", "minute": "minute", "mins": "minute", "min": "minute",
                   "hours": "hour", "hour": "hour", "hrs": "hour", "hr": "hour", "h": "hour", "days": "day", "day": "day", "d": "day",
                   "weeks": "week", "week": "week", "wks": "week", "wk": "week", "months": "month", "month": "month", "mos": "month",
                   "years": "year", "year": "year", "yrs": "year", "yr": "year"},
    "number_words": {"one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10,
                     "eleven": 11, "twelve": 12, "eighteen": 18, "twenty-four": 24, "thirty": 30, "fifty-two": 52},
    "buckets": [
      {"id": "up to 1 day", "max_days": 1},
      {"id": "over 1 day to 4 weeks", "max_days": 28},
      {"id": "over 4 weeks to 6 months", "max_days": 183},
      {"id": "over 6 to 12 months", "max_days": 366},
      {"id": "over 12 months", "max_days": null}
    ],
    "empty_bucket": "not stated",
    "unparseable_bucket": "unparseable",
    "note": "The longest duration written in the time frame decides the bucket. A unit followed by several numbers is read whole: 'Weeks 4-24', 'Week 4, 8, 12, 16', 'Years 1 to 5', 'Days 1 through 29' and 'Weeks 2 and 6' give their largest number. A time frame with no number and unit, such as 'Baseline' or 'end of study', is unparseable; an empty one is not stated. Boundary choice: the written number decides, with no adjustment for how a study counts its first day, so 'Day 28' is 'over 1 day to 4 weeks' and 'Day 29' (often a four-week visit when day 1 is the first dose) is 'over 4 weeks to 6 months'."
  }
}
