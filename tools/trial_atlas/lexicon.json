{
  "lexicon_version": "0.1.0-draft",
  "status": "First draft for review, written 2026-10-10 from the taxonomy in proposals/2026-10-10-trial-endpoint-atlas.md. Not yet checked against any real registry wording or against the frozen set. Every rule carries examples that test_lexicon.py runs; they are made-up English, not registry text.",
  "matching": {
    "match_fields": ["measure"],
    "fallback_fields": ["description"],
    "note": "Rules run on the outcome's measure first. Only when no class rule matches there are they run on its description. The time frame is used for bucketing only. Patterns are Python regular expressions, case-insensitive unless case_sensitive is true."
  },
  "domains": [
    {"id": "pulmonary", "label": "Pulmonary function", "classes": [
      {"id": "fev1", "label": "FEV1"},
      {"id": "spirometry_other", "label": "Other spirometry"},
      {"id": "lci", "label": "Lung clearance index"},
      {"id": "lung_function_unspecified", "label": "Lung function, not specified"}]},
    {"id": "cftr_function", "label": "CFTR function", "classes": [
      {"id": "sweat_chloride", "label": "Sweat chloride", "cf_specific": true},
      {"id": "npd", "label": "Nasal potential difference", "cf_specific": true},
      {"id": "icm", "label": "Intestinal current measurement", "cf_specific": true},
      {"id": "cftr_biomarker_other", "label": "Other CFTR biomarker", "cf_specific": true}]},
    {"id": "exacerbations", "label": "Exacerbations", "classes": [
      {"id": "exacerbations", "label": "Pulmonary exacerbations"}]},
    {"id": "nutrition_growth", "label": "Nutrition and growth", "classes": [
      {"id": "nutrition_growth", "label": "Nutrition and growth"}]},
    {"id": "gi_pancreatic", "label": "Gastrointestinal and pancreatic", "classes": [
      {"id": "gi_pancreatic", "label": "Gastrointestinal and pancreatic"}]},
    {"id": "glucose_cfrd", "label": "Glucose and CF-related diabetes", "classes": [
      {"id": "glucose_cfrd", "label": "Glucose and CF-related diabetes"}]},
    {"id": "liver", "label": "Liver", "classes": [
      {"id": "liver", "label": "Liver"}]},
    {"id": "sinus_upper_airway", "label": "Sinus and upper airway", "classes": [
      {"id": "sinus_upper_airway", "label": "Sinus and upper airway"}]},
    {"id": "patient_reported", "label": "Patient-reported", "classes": [
      {"id": "cfqr", "label": "CFQ-R", "cf_specific": true},
      {"id": "pro_named_other", "label": "Other named instrument"},
      {"id": "pro_unnamed", "label": "Patient-reported, instrument not named"}]},
    {"id": "imaging", "label": "Imaging", "classes": [
      {"id": "imaging", "label": "Imaging"}]},
    {"id": "microbiology_sputum", "label": "Microbiology and sputum", "classes": [
      {"id": "microbiology_sputum", "label": "Microbiology and sputum"}]},
    {"id": "inflammation_markers", "label": "Inflammation markers", "classes": [
      {"id": "inflammation_markers", "label": "Inflammation markers"}]},
    {"id": "healthcare_use", "label": "Healthcare use", "classes": [
      {"id": "healthcare_use", "label": "Healthcare use"}]},
    {"id": "survival_transplant", "label": "Survival and transplant", "classes": [
      {"id": "survival_transplant", "label": "Survival and transplant"}]},
    {"id": "safety", "label": "Safety and tolerability", "classes": [
      {"id": "safety_tolerability", "label": "Safety and tolerability"}]},
    {"id": "pharmacokinetics", "label": "Pharmacokinetics", "classes": [
      {"id": "pharmacokinetics", "label": "Pharmacokinetics"}]},
    {"id": "feasibility_adherence", "label": "Feasibility and adherence", "classes": [
      {"id": "feasibility_adherence", "label": "Feasibility and adherence"}]},
    {"id": "other", "label": "Other", "classes": [
      {"id": "other", "label": "Other", "assigned_by": "a model tag with an exact quote, or a person; no rule assigns it"}]},
    {"id": "not_stated", "label": "Not stated", "classes": [
      {"id": "not_stated", "label": "Not stated", "assigned_by": "rules NS-00, NS-01 and NS-V1 only"}]}
  ],
  "safety_subtypes": ["adverse_events", "serious_adverse_events", "laboratory", "vital_signs_ecg", "dose_limiting", "tolerability", "unspecified"],
  "rules": [
    {"id": "FEV1-01", "class": "fev1", "pattern": "(?<![A-Za-z0-9])(?:pp|%\\s?)?FEV\\s?[-_]?(?:1|₁)(?![0-9])",
     "note": "Only the explicit acronym. Vague wording is never read as FEV1 (see LUNGFN-V1).",
     "examples": {"match": ["Change in ppFEV1", "Absolute change in FEV1", "FEV 1 percent predicted", "FEV₁ (L)", "% FEV1"],
                  "no_match": ["Change in FEV6", "Lung function", "FEF25-75", "FVC"]}},
    {"id": "FEV1-02", "class": "fev1", "pattern": "\\bforced expiratory volume (?:in|at) (?:1|one) s(?:ec(?:ond)?)?\\b",
     "examples": {"match": ["forced expiratory volume in one second", "Forced Expiratory Volume in 1 Second", "forced expiratory volume in 1 s"],
                  "no_match": ["forced expiratory volume in 6 seconds", "forced vital capacity"]}},
    {"id": "SPIRO-01", "class": "spirometry_other", "pattern": "\\bFVC\\b|\\bforced vital capacity\\b|\\bFEF\\s?25\\s?[-–]\\s?75|\\bFEF25|\\bpeak expiratory flow\\b|\\bforced expiratory flow\\b",
     "examples": {"match": ["Change in FVC", "forced vital capacity (L)", "FEF25-75", "Peak expiratory flow"],
                  "no_match": ["FEV1", "vital signs"]}},
    {"id": "SPIRO-02", "class": "spirometry_other", "pattern": "\\bspirometr(?:y|ic)\\b", "suppressed_by": ["fev1", "SPIRO-01"],
     "note": "The word spirometry alone; dropped when a named spirometric measure is matched, since it then names only the method.",
     "examples": {"match": ["Spirometry", "spirometric indices"], "no_match": ["spirometer calibration"]}},
    {"id": "LCI-01", "class": "lci", "pattern": "\\blung clearance index\\b|\\bmultiple[- ]breath (?:inert gas |nitrogen |sulph?ur hexafluoride )?washout\\b",
     "examples": {"match": ["Change in lung clearance index", "Multiple-breath washout"], "no_match": ["mucociliary clearance", "airway clearance"]}},
    {"id": "LCI-02", "class": "lci", "pattern": "\\bLCI(?:\\s?2\\.5|5)?\\b|\\bMBW\\b", "case_sensitive": true,
     "examples": {"match": ["LCI2.5", "Change in LCI", "MBW outcomes"], "no_match": ["lci", "PLCI score"]}},
    {"id": "LUNGFN-V1", "class": "lung_function_unspecified", "vague": true, "pattern": "\\b(?:lung|pulmonary|respiratory) function(?: tests?| testing)?\\b",
     "suppressed_by": ["fev1", "spirometry_other", "lci"],
     "note": "Vague wording. Never inferred to FEV1; its share is reported as a finding.",
     "examples": {"match": ["Lung function", "Improvement in pulmonary function", "respiratory function tests"], "no_match": ["liver function", "lung transplant"]}},
    {"id": "SWEAT-01", "class": "sweat_chloride", "pattern": "\\bsweat[\\s-]+(?:chloride|cl-?)(?![a-z])|\\bsweat test(?:ing)?\\b|\\bswcl\\b",
     "examples": {"match": ["Change in sweat chloride", "Sweat Cl concentration", "sweat test", "SwCl"], "no_match": ["night sweats", "chloride channel"]}},
    {"id": "NPD-01", "class": "npd", "pattern": "\\bnasal potential difference\\b",
     "examples": {"match": ["Change in nasal potential difference"], "no_match": ["nasal polyps"]}},
    {"id": "NPD-02", "class": "npd", "pattern": "\\bNPD\\b", "case_sensitive": true,
     "examples": {"match": ["NPD response"], "no_match": ["npd"]}},
    {"id": "ICM-01", "class": "icm", "pattern": "\\bintestinal current measurements?\\b|\\bshort[- ]circuit current\\b|\\bUssing chambers?\\b",
     "examples": {"match": ["Intestinal current measurement", "short-circuit current in rectal biopsies"], "no_match": ["intestinal obstruction"]}},
    {"id": "ICM-02", "class": "icm", "pattern": "\\bICM\\b", "case_sensitive": true,
     "examples": {"match": ["ICM in rectal biopsies"], "no_match": ["icm"]}},
    {"id": "CFTRBIO-01", "class": "cftr_biomarker_other",
     "pattern": "\\bCFTR[\\s-]+(?:function|activity|protein|expression|mRNA|maturation|conductance)\\b|\\borganoids?\\b|\\bforskolin[- ]induced swelling\\b",
     "suppressed_by": ["sweat_chloride", "npd", "icm"],
     "note": "Dropped when the entry names sweat chloride, NPD or ICM: the named measure is then the class.",
     "examples": {"match": ["CFTR function in nasal cells", "Forskolin-induced swelling of organoids"], "no_match": ["CFTR modulator", "CFTR genotype"]}},
    {"id": "EXAC-01", "class": "exacerbations", "pattern": "\\bexacerbations?\\b",
     "examples": {"match": ["Rate of pulmonary exacerbations", "Time to first exacerbation"], "no_match": ["exacerbating factors"]}},
    {"id": "EXAC-02", "class": "exacerbations", "pattern": "\\bPEx\\b", "case_sensitive": true,
     "examples": {"match": ["Number of PEx"], "no_match": ["pex"]}},
    {"id": "NUTR-01", "class": "nutrition_growth",
     "pattern": "\\bbody mass index\\b|\\bweight(?:[- ]for[- ](?:age|length|height))?\\b|\\bheight\\b|\\bnutritional status\\b|\\bfat[- ]free mass\\b|\\bbody composition\\b|\\banthropometr\\w*|\\bgrowth (?:velocity|rate)\\b|\\b(?:height|length|weight|BMI)[- ]z[- ]?scores?\\b|\\bmid[- ]upper arm circumference\\b",
     "examples": {"match": ["Change in body mass index", "Weight-for-age z-score", "Height", "fat-free mass"], "no_match": ["bacterial growth", "heightened"]}},
    {"id": "NUTR-02", "class": "nutrition_growth", "pattern": "\\bBMI\\b", "case_sensitive": true,
     "examples": {"match": ["Change in BMI"], "no_match": ["bmi"]}},
    {"id": "GI-01", "class": "gi_pancreatic",
     "pattern": "\\bcoefficient of fat absorption\\b|\\bfat absorption\\b|\\bfa?ecal elastase\\b|\\bsteatorrho?ea\\b|\\bpancreatic (?:function|insufficiency|sufficiency|enzymes?|elastase)\\b|\\bstool (?:fat|frequency|consistency)\\b|\\bgastrointestinal symptoms?\\b|\\bdistal intestinal obstruction\\b|\\bconstipation\\b|\\babdominal pain\\b|\\bimmunoreactive trypsinogen\\b|\\bfa?ecal calprotectin\\b|\\bmalabsorption\\b",
     "examples": {"match": ["Coefficient of fat absorption", "Faecal elastase", "Abdominal pain score", "distal intestinal obstruction syndrome"], "no_match": ["pancreatitis", "fat-free mass"]}},
    {"id": "GI-02", "class": "gi_pancreatic", "pattern": "\\bCFA\\b|\\bDIOS\\b|\\bIRT\\b", "case_sensitive": true,
     "examples": {"match": ["Change in CFA", "Episodes of DIOS"], "no_match": ["cfa"]}},
    {"id": "GLU-01", "class": "glucose_cfrd",
     "pattern": "\\bglucose\\b|\\bHbA1c\\b|\\bha?emoglobin A1c\\b|\\bglycated ha?emoglobin\\b|\\binsulin\\b|\\b(?:cystic fibrosis|CF)[- ]related diabetes\\b|\\bdiabetes\\b|\\bglyca?emic\\b",
     "examples": {"match": ["Change in HbA1c", "Oral glucose tolerance test", "Insulin secretion", "Glycaemic control"], "no_match": ["glucagon-like peptide receptor"]}},
    {"id": "GLU-02", "class": "glucose_cfrd", "pattern": "\\bOGTT\\b|\\bCFRD\\b|\\bA1C\\b", "case_sensitive": true,
     "examples": {"match": ["2-hour OGTT", "Incidence of CFRD"], "no_match": ["ogtt"]}},
    {"id": "LIVER-01", "class": "liver",
     "pattern": "\\bliver\\b|\\bhepatic (?:fibrosis|steatosis|stiffness|function|disease)\\b|\\bcirrhosis\\b|\\bhepatobiliary\\b|\\bbiliary\\b|\\bportal hypertension\\b",
     "examples": {"match": ["Change in liver stiffness", "Hepatic steatosis", "Portal hypertension"], "no_match": ["hepatic impairment cohort", "deliverable"]}},
    {"id": "LIVER-02", "class": "liver", "pattern": "\\bCFLD\\b", "case_sensitive": true,
     "examples": {"match": ["Progression of CFLD"], "no_match": ["cfld"]}},
    {"id": "SINUS-01", "class": "sinus_upper_airway",
     "pattern": "\\bsinus(?:es)?\\b(?! (?:rhythm|tachycardia|bradycardia|arrhythmia))|\\bsinusitis\\b|\\brhinosinusitis\\b|\\bsino[- ]?nasal\\b|\\bnasal polyp\\w*|\\bupper airways?\\b|\\bparanasal\\b|\\bSNOT[- ]?2[02]\\b",
     "examples": {"match": ["Sinus symptoms", "Chronic rhinosinusitis", "Sino-Nasal Outcome Test", "nasal polyp score"], "no_match": ["sinus rhythm on ECG", "nasal potential difference"]}},
    {"id": "CFQR-01", "class": "cfqr", "pattern": "\\bCFQ[- ]?R\\b|\\bcystic fibrosis questionnaire(?:[- ]revised)?\\b|\\bCFQ\\b",
     "examples": {"match": ["CFQ-R respiratory domain", "Cystic Fibrosis Questionnaire-Revised", "CFQR"], "no_match": ["questionnaire"]}},
    {"id": "PRO-01", "class": "pro_named_other",
     "pattern": "\\bSF[- ]?(?:36|12)\\b|\\bEQ[- ]?5D(?:[- ][35]L|-Y)?\\b|\\bPedsQL\\b|\\bSGRQ\\b|\\bSt\\.? George'?s Respiratory Questionnaire\\b|\\bCRISS\\b|\\bCFRSD\\b|\\bCystic Fibrosis Respiratory Symptom Diary\\b|\\bQOL[- ]B\\b|\\bLeicester Cough Questionnaire\\b|\\bSNOT[- ]?2[02]\\b|\\bSino[- ]?Nasal Outcome Test\\b|\\bPROMIS\\b|\\bHADS\\b|\\bPHQ[- ]?9\\b|\\bGAD[- ]?7\\b|\\bTSQM\\b|\\bAsthma Control Questionnaire\\b",
     "note": "Named instruments other than the CFQ-R. Instrument names are kept as written; no acronym is expanded.",
     "examples": {"match": ["EQ-5D-5L", "SNOT-22 score", "St George's Respiratory Questionnaire", "CFRSD-CRISS"], "no_match": ["quality of life", "CFQ-R"]}},
    {"id": "PRO-02", "class": "pro_unnamed",
     "pattern": "\\bquality of life\\b|\\bQoL\\b|\\bpatient[- ]reported\\b|\\bquestionnaires?\\b|\\bsymptom (?:scores?|diary|diaries|burden)\\b|\\bsatisfaction\\b|\\bwell[- ]being\\b",
     "suppressed_by": ["cfqr", "pro_named_other"],
     "examples": {"match": ["Quality of life", "Patient-reported symptoms", "Treatment satisfaction"], "no_match": ["quality control"]}},
    {"id": "IMG-01", "class": "imaging",
     "pattern": "\\bcomputed tomography\\b|\\bmagnetic resonance\\b|\\bchest (?:x[- ]?ray|radiograph\\w*)\\b|\\bradiograph\\w*|\\bultrasound\\b|\\bultrasonograph\\w*|\\belastography\\b|\\bBrody score\\b|\\bimaging\\b|\\bscintigraph\\w*|\\bhyperpolari[sz]ed\\b",
     "examples": {"match": ["Chest computed tomography score", "Transient elastography", "Chest X-ray"], "no_match": ["image quality questionnaire"]}},
    {"id": "IMG-02", "class": "imaging", "pattern": "\\bCT\\b|\\bMRI\\b|\\bHRCT\\b|\\bDXA\\b|\\bDEXA\\b", "case_sensitive": true,
     "examples": {"match": ["Chest CT score", "Lung MRI"], "no_match": ["ct", "CTX"]}},
    {"id": "MICRO-01", "class": "microbiology_sputum",
     "pattern": "\\bsputum\\b|\\bpseudomonas\\b|\\bP\\.? ?aeruginosa\\b|\\bstaphylococc\\w*|\\bS\\.? ?aureus\\b|\\bburkholderia\\b|\\bmycobacteri\\w*|\\bbacterial (?:load|density|counts?)\\b|\\bcolony[- ]forming units?\\b|\\bmicrobio(?:me|ta|logy|logical)\\b|\\beradication\\b|\\b(?:throat|bacterial) cultures?\\b|\\baspergillus\\b|\\bfungal\\b|\\bstenotrophomonas\\b|\\bachromobacter\\b",
     "examples": {"match": ["Sputum Pseudomonas aeruginosa density", "Eradication of P. aeruginosa", "Mycobacterial culture conversion"], "no_match": ["cell culture"]}},
    {"id": "MICRO-02", "class": "microbiology_sputum", "pattern": "\\bMRSA\\b|\\bNTM\\b|\\bCFU\\b", "case_sensitive": true,
     "examples": {"match": ["MRSA eradication", "NTM culture"], "no_match": ["cfu"]}},
    {"id": "INFL-01", "class": "inflammation_markers",
     "pattern": "\\binflammat(?:ion|ory)\\b|\\bneutrophil elastase\\b|\\binterleukin[- ]?\\w*|\\bIL-?(?:1β|1b|1|6|8|17)\\b|\\bC-reactive protein\\b|\\btumou?r necrosis factor\\b|\\bcalprotectin\\b|\\bcytokines?\\b|\\bneutrophil (?:counts?|numbers?)\\b|\\bwhite (?:blood )?cell counts?\\b",
     "examples": {"match": ["Sputum neutrophil elastase", "IL-8 concentration", "Inflammatory markers", "C-reactive protein"], "no_match": ["neutrophil function assay"]}},
    {"id": "INFL-02", "class": "inflammation_markers", "pattern": "\\bCRP\\b|\\bTNF\\b", "case_sensitive": true,
     "examples": {"match": ["Serum CRP", "TNF level"], "no_match": ["crp"]}},
    {"id": "HCU-01", "class": "healthcare_use",
     "pattern": "\\bhospitali[sz](?:ations?|ed)\\b|\\bhospital (?:admissions?|days|stays?|visits?)\\b|\\blength of (?:hospital )?stay\\b|\\bemergency (?:department|room) visits?\\b|\\b(?:IV|intravenous) antibiotic (?:courses?|days|use|treatment)\\b|\\bhealth ?care (?:use|utili[sz]ation|resource use|costs?)\\b|\\bresource (?:use|utili[sz]ation)\\b|\\bcosts?\\b|\\bcost[- ]effectiveness\\b|\\bclinic visits?\\b",
     "examples": {"match": ["Number of hospitalizations", "Days of intravenous antibiotic treatment", "Healthcare costs"], "no_match": ["hospital-based study"]}},
    {"id": "SURV-01", "class": "survival_transplant",
     "pattern": "\\bsurvival\\b|\\bmortality\\b|\\btransplant(?:ation|ed)?\\b|\\bbronchiolitis obliterans\\b|\\bchronic lung allograft dysfunction\\b|\\bgraft\\b",
     "examples": {"match": ["Overall survival", "Time to lung transplantation", "All-cause mortality"], "no_match": ["survey"]}},
    {"id": "SURV-02", "class": "survival_transplant", "pattern": "\\bCLAD\\b|\\bBOS\\b", "case_sensitive": true,
     "examples": {"match": ["Freedom from CLAD"], "no_match": ["bos"]}},
    {"id": "SURV-03", "class": "survival_transplant", "pattern": "\\bdeaths?\\b|\\bdied\\b", "suppressed_by": ["safety_tolerability"],
     "note": "Deaths counted inside a safety outcome stay safety.",
     "examples": {"match": ["Number of deaths"], "no_match": ["deathly"]}},
    {"id": "SAFE-AE", "class": "safety_tolerability", "subtype": "adverse_events",
     "pattern": "(?<!serious )\\badverse (?:events?|effects?|reactions?|drug reactions?)\\b|\\bside[- ]effects?\\b|\\btreatment[- ]emergent\\b",
     "examples": {"match": ["Number of participants with adverse events", "Side effects", "Treatment-emergent events"], "no_match": ["Number of participants with serious adverse events"]}},
    {"id": "SAFE-AE2", "class": "safety_tolerability", "subtype": "adverse_events", "pattern": "\\bT?EAEs?\\b|\\bAEs?\\b", "case_sensitive": true,
     "examples": {"match": ["Incidence of TEAEs", "AEs by severity"], "no_match": ["aes", "SAEs"]}},
    {"id": "SAFE-SAE", "class": "safety_tolerability", "subtype": "serious_adverse_events", "pattern": "\\bserious adverse (?:events?|reactions?)\\b",
     "examples": {"match": ["Number of participants with serious adverse events"], "no_match": ["adverse events"]}},
    {"id": "SAFE-SAE2", "class": "safety_tolerability", "subtype": "serious_adverse_events", "pattern": "\\bSAEs?\\b", "case_sensitive": true,
     "examples": {"match": ["Incidence of SAEs"], "no_match": ["saes"]}},
    {"id": "SAFE-LAB", "class": "safety_tolerability", "subtype": "laboratory",
     "pattern": "\\b(?:clinical |safety )?laboratory (?:values?|abnormalit\\w*|parameters?|tests?|assessments?|results?)\\b|\\blab abnormalit\\w*|\\bliver (?:function|enzymes?) (?:tests?|elevations?)\\b|\\btransaminases?\\b|\\bha?ematology\\b|\\bclinical chemistry\\b|\\burinalysis\\b",
     "examples": {"match": ["Clinical laboratory abnormalities", "Liver enzyme elevations", "Haematology"], "no_match": ["laboratory-confirmed infection"]}},
    {"id": "SAFE-VITAL", "class": "safety_tolerability", "subtype": "vital_signs_ecg",
     "pattern": "\\bvital signs?\\b|\\belectrocardiogra\\w*|\\bECGs?\\b|\\bQTc?F?\\b|\\bblood pressure\\b|\\bheart rate\\b",
     "examples": {"match": ["Vital signs", "12-lead ECG", "QTcF interval"], "no_match": ["vitality"]}},
    {"id": "SAFE-DLT", "class": "safety_tolerability", "subtype": "dose_limiting",
     "pattern": "\\bdose[- ]limiting toxicit\\w*|\\bmaximum tolerated dose\\b",
     "examples": {"match": ["Dose-limiting toxicities", "Maximum tolerated dose"], "no_match": ["dose finding"]}},
    {"id": "SAFE-DLT2", "class": "safety_tolerability", "subtype": "dose_limiting", "pattern": "\\bDLTs?\\b|\\bMTD\\b", "case_sensitive": true,
     "examples": {"match": ["Number of DLTs", "MTD"], "no_match": ["dlt"]}},
    {"id": "SAFE-TOL", "class": "safety_tolerability", "subtype": "tolerability",
     "pattern": "\\btolerability\\b|\\btolerated\\b|(?<!glucose )\\btolerance\\b(?! test)|\\bdiscontinu\\w* (?:due to|because of)\\b|\\bwithdraw\\w* (?:due to|because of)\\b|\\bbronchospasm\\b|\\bbronchoconstriction\\b",
     "examples": {"match": ["Tolerability", "Discontinuation due to adverse events", "Acute bronchospasm"], "no_match": ["oral glucose tolerance test", "glucose tolerance"]}},
    {"id": "SAFE-UNSPEC", "class": "safety_tolerability", "subtype": "unspecified", "pattern": "\\bsafety\\b|\\btoxicit(?:y|ies)\\b",
     "suppressed_by": ["SAFE-AE", "SAFE-AE2", "SAFE-SAE", "SAFE-SAE2", "SAFE-LAB", "SAFE-VITAL", "SAFE-DLT", "SAFE-DLT2", "SAFE-TOL"],
     "note": "The word safety alone; its subtype is unspecified unless another safety rule names what was measured.",
     "examples": {"match": ["Safety", "Toxicity"], "no_match": ["safely"]}},
    {"id": "PK-01", "class": "pharmacokinetics",
     "pattern": "\\bpharmacokinetic\\w*|\\bplasma (?:concentrations?|levels?)\\b|\\bserum (?:concentrations?|levels?) of\\b|\\bmaximum (?:plasma |serum |observed )?concentration\\b|\\barea under the (?:plasma |serum )?(?:concentration[- ]time )?curve\\b|\\bhalf[- ]life\\b|\\btrough concentrations?\\b|\\bbioavailability\\b|\\bbioequivalence\\b|\\b(?:apparent|renal|total body|oral|systemic) clearance\\b|\\bvolume of distribution\\b|\\btime to (?:maximum|peak) (?:plasma )?concentration\\b",
     "examples": {"match": ["Maximum plasma concentration", "Area under the concentration-time curve", "Half-life", "Apparent clearance"], "no_match": ["lung clearance index", "airway clearance"]}},
    {"id": "PK-02", "class": "pharmacokinetics", "pattern": "\\bPK\\b|\\bC\\s?max\\b|\\bAUC\\w*|\\bT\\s?max\\b|\\bt1/2|\\bt½|\\bCL/F\\b|\\bCtrough\\b", "case_sensitive": true,
     "examples": {"match": ["Cmax", "AUC0-24", "Half-life (t1/2)", "PK parameters"], "no_match": ["pk", "cmax"]}},
    {"id": "FEAS-01", "class": "feasibility_adherence",
     "pattern": "\\badherence\\b|\\bcompliance\\b|\\bfeasibility\\b|\\brecruitment (?:rates?|targets?)\\b|\\bretention\\b|\\bacceptability\\b|\\bcompletion rates?\\b|\\busability\\b|\\buptake\\b|\\bproportion of (?:participants|patients|subjects) (?:who )?(?:completed?|completing)\\b",
     "examples": {"match": ["Adherence to airway clearance", "Feasibility of recruitment", "Retention at 12 months"], "no_match": ["adherent mucus"]}}
  ],
  "composite_rules": [
    {"id": "COMP-01", "pattern": "\\bcomposite\\b|\\bcombined (?:end ?point|outcome)\\b|\\btime to (?:the )?first of\\b",
     "note": "Sets the composite flag; the component classes are the class tags of the same entry. Matched on measure and description.",
     "examples": {"match": ["Composite of exacerbation or hospitalization", "Combined endpoint"], "no_match": ["compositional analysis"]}}
  ],
  "not_stated_rules": [
    {"id": "NS-00", "kind": "no_primary_outcome", "note": "The study entered no primary outcome. Applied in code, not by a pattern."},
    {"id": "NS-01", "kind": "placeholder", "pattern": "^\\s*(?:TBD|TBA|N/?A|none|not applicable|to be (?:determined|confirmed)|unknown|-+|\\.+)?\\s*$",
     "note": "Applied to the measure when no class rule matched in measure or description.",
     "examples": {"match": ["TBD", "", "N/A", "--"], "no_match": ["FEV1", "Efficacy"]}},
